<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DropWheel</AssemblyName>
    <DebugType>none</DebugType>
    <RootNamespace>FileAction.App</RootNamespace>
    <AssemblyTitle>DropWheel</AssemblyTitle>
    <CompanyName>DropWheel</CompanyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DropWheel.ico</ApplicationIcon>
    <StartupObject>FileAction.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>2.0.0</Version>
    <SatelliteResourceLanguages>cs;en</SatelliteResourceLanguages>
    <!--
      Smaller download: trim only libraries marked as trim-safe (the .NET runtime, the Windows SDK projection…);
      WPF and our own code are kept whole. The UI self-test in CI runs conversions in the trimmed build.
    -->
    <!-- Explorer selection and Outlook drops use classic COM, which trimming turns off by default. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Product>DropWheel</Product>
    <Description>Převod souborů přetažením na kruhové menu</Description>
    <!-- ThemeMode (Fluent) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Only when publishing for a platform (trimming needs a runtime identifier). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DropWheel.ico" />
    <Resource Include="Assets\DropWheel.png" />
    <Resource Include="Assets\DropWheel-tray-dark.ico" />
    <Resource Include="Assets\DropWheel-tray-light.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileAction.Core\FileAction.Core.csproj" />
  </ItemGroup>

</Project>
