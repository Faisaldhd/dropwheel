# Maintainer: Metamorfolog <https://github.com/Metamorfolog>
# Generated by CI from packaging/aur/PKGBUILD.in – edit the template, not the AUR copy.
pkgname=dropwheel-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Convert files by dropping them on a radial wheel: images, audio, video, PDF, documents, spreadsheets, archives"
arch=('x86_64')
url="https://github.com/Metamorfolog/file_action"
license=('@LICENSE@')
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'openssl' 'fontconfig' 'libx11' 'libxi' 'libxrandr' 'libxcursor' 'libice' 'libsm')
optdepends=(
  'ffmpeg: audio and video conversions'
  'pandoc-cli: document conversions (DOCX, Markdown, EPUB, …)'
  'libreoffice-fresh: Office files and export to PDF'
  'tesseract: extract text from images (OCR)'
  'tesseract-data-eng: English OCR'
  'tesseract-data-ces: Czech OCR'
)
provides=('dropwheel')
conflicts=('dropwheel')
options=('!strip' '!debug')
source=("@SOURCE@")
sha256sums=('@SHA256@')

package() {
  install -d "$pkgdir/opt/dropwheel" "$pkgdir/usr/bin"
  cp -a dropwheel/app/. "$pkgdir/opt/dropwheel/"
  ln -s /opt/dropwheel/dropwheel "$pkgdir/usr/bin/dropwheel"
  install -Dm644 dropwheel/share/dropwheel.desktop "$pkgdir/usr/share/applications/dropwheel.desktop"
  install -Dm644 dropwheel/share/dropwheel.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/dropwheel.png"
  install -Dm755 dropwheel/share/dolphin-servicemenu.desktop "$pkgdir/usr/share/kio/servicemenus/dropwheel.desktop"
  install -Dm644 dropwheel/share/dropwheel.nemo_action "$pkgdir/usr/share/nemo/actions/dropwheel.nemo_action"
  install -Dm644 dropwheel/share/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 dropwheel/share/THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
}
